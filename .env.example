PORT=3000
DB_PATH=./portfolio.db
CORS_ORIGIN=*

# Email notifications (optional)
# Leave EMAIL_USER/EMAIL_PASS blank to disable — the form will still save
# messages to the database either way.
#
# EMAIL_USER: the Gmail address that sends the notification
# EMAIL_PASS: a Gmail "App Password" (NOT your normal Gmail password —
#   generate one at https://myaccount.google.com/apppasswords, requires
#   2-Step Verification to be turned on)
# NOTIFY_EMAIL: the address you want notifications sent TO (defaults to
#   EMAIL_USER if left blank)
EMAIL_USER=
EMAIL_PASS=
NOTIFY_EMAIL=
